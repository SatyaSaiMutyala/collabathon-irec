APP_NAME=Collabathon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Echoes the login OTP back as `debug_code` on /auth/otp/send so a test build can fill
# it in — there is no SMS gateway yet. Off-production this happens regardless; set this
# only on a deployed TEST server (APP_ENV there is production, so nothing else can tell
# it apart). With it on, anyone who can call that endpoint can sign in as any channel
# partner. Never set it where real accounts exist.
OTP_EXPOSE_CODE=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Uploads go to S3 when FILESYSTEM_DISK=s3 — see docs/AWS-S3-SETUP.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Key prefixes for the public and private halves of the bucket. The bucket policy
# grants read on the public one, so changing these means changing that policy too.
AWS_PUBLIC_PREFIX=public
AWS_PRIVATE_PREFIX=private
# Optional: a CloudFront domain (plus prefix) to serve public files through, e.g.
# https://d111111abcdef8.cloudfront.net/public — unset means the S3 endpoint.
AWS_URL=

VITE_APP_NAME="${APP_NAME}"
FCM_CREDENTIALS=app/firebase/service-account.json

# HTTP-referrer-restrict this to the admin panel domain in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
