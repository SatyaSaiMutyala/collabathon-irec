<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Android 13+ (API 33) will not deliver a notification until the user grants this at
      runtime. Declaring it is only half the job — messaging().requestPermission() in
      src/services/push.js is what actually asks; without the declaration that call
      silently resolves denied.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      No gallery permission by design — do not add one back.

      Google Play's Photo and Video Permissions policy only allows READ_MEDIA_IMAGES /
      READ_MEDIA_VIDEO when the system photo picker cannot deliver core functionality, and
      it rejected the release that declared them. Attachment fields (photo, PAN/Aadhaar/
      RERA/cheque scans) now select through launchImageLibrary, which is the system photo
      picker (PickVisualMedia): the user picks one image and the app receives read access
      to just that URI, with no permission requested. The cropper is handed that URI rather
      than browsing MediaStore itself, and the terms PDF is written by Android's
      DownloadManager on the app's behalf — so nothing here needs broad storage access.

      tools:node="remove" strips these if a dependency's manifest reintroduces them: Play
      reviews the merged manifest, not this file.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />

    <!--
      Android 11 (API 30) package visibility. Without this, Linking.canOpenURL() returns
      false for http/https even when a browser is installed, because the app cannot see
      any package that handles the intent. Property brochures, price lists, floor plans
      and virtual tours all open externally, so the app has to be able to resolve them.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <!--
        Read from local.properties (never committed — see build.gradle) rather than a
        literal value here, so the key an admin saves at /admin/settings never has to
        be pasted into a file this repo tracks. react-native-maps' Android map view
        will not render without a real value: the native Google Maps SDK reads this
        tag at process start, before any JS runs, so there is no way to supply the key
        at runtime instead — copy the admin-saved key into local.properties and
        rebuild for it to take effect. iOS needs none of this; it uses Apple Maps.
      -->
      <meta-data
        android:name="com.google.android.geo.API_KEY"
        android:value="${GOOGLE_MAPS_API_KEY}" />

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/SplashTheme"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        Overrides the theme react-native-image-crop-picker declares for this activity in
        its own manifest (merged in automatically) — see the matching note on UCropTheme
        in res/values/styles.xml for why: its default theme lets the Close/Done icons draw
        under the status bar on API 35+.
      -->
      <activity
        android:name="com.yalantis.ucrop.UCropActivity"
        android:theme="@style/UCropTheme"
        tools:replace="android:theme" />
    </application>
</manifest>
